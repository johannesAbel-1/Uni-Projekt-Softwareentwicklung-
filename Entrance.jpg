:root{color-scheme:dark;--bg:#0B1220;--surface:#111e30;--surface2:#17263B;--text:#F5F7FA;--muted:#a9bacd;--accent:#65D9FF;--silver:#BFC7D1;--line:#ffffff14;--green:#89dbbd;--orange:#f3c48b;--red:#ffaaa9;font-family:'Arial Nova Light','Arial Nova',Arial,sans-serif;font-size:15px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select{font:inherit}button,a,input,select{ -webkit-tap-highlight-color:transparent}button{cursor:pointer}button{color:inherit}button:disabled{opacity:.45;cursor:not-allowed}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:4px}a{color:inherit;text-decoration:none}button{border:0}h1,h2,h3,p{margin-top:0}h2{font-size:25px;font-weight:500;letter-spacing:-.7px}h3{font-size:17px;font-weight:500}p{line-height:1.7}b,strong{font-weight:600}[hidden]{display:none!important}.muted{color:var(--muted)}.small{font-size:12px}.skip{position:absolute;left:10px;top:-60px;z-index:20;padding:12px;background:var(--accent);color:var(--bg)}.skip:focus{top:10px}.brand{display:block;width:174px;height:62px;overflow:hidden}.brand img{width:100%;height:100%;object-fit:contain;mix-blend-mode:screen}.landing-header{height:112px;padding:22px 5%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.header-note{font-size:10px;letter-spacing:2px;color:var(--muted)}.text-button{background:transparent;padding:5px 0;color:var(--accent);font-size:13px}.text-button span{margin-left:18px}.hero{min-height:calc(100vh - 180px);max-width:1600px;margin:auto;padding:70px 5%;display:grid;grid-template-columns:1.15fr .65fr 370px;align-items:center;position:relative;isolation:isolate;gap:0}.hero-copy{z-index:2}.eyebrow{font-size:10px;letter-spacing:2.6px;color:var(--accent);display:flex;gap:10px;align-items:center;margin-bottom:30px}.eyebrow i{width:5px;height:5px;background:var(--accent);border-radius:50%;box-shadow:0 0 12px var(--accent)}h1{font-size:clamp(40px,4.15vw,66px);font-weight:400;letter-spacing:-2.4px;line-height:1.14;margin-bottom:25px}h1 span{color:var(--accent)}.hero-lead{color:var(--muted);font-size:15px;line-height:1.9}.hero-actions{display:flex;align-items:flex-start;gap:14px;flex-direction:column;margin-top:32px}.primary{background:var(--accent);color:#092033;border:1px solid var(--accent);border-radius:9px;padding:14px 19px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:28px;box-shadow:0 4px 20px #65d9ff0a;transition:transform .2s,background .2s}.primary:hover{background:#a2e9ff;transform:translateY(-2px)}.secondary{background:transparent;border:1px solid #ffffff26;border-radius:9px;padding:12px 17px;font-size:13px}.secondary:hover{background:var(--surface2)}.full{width:100%}.hero-proof{display:flex;gap:22px;margin-top:60px;font-size:10px;color:var(--muted);white-space:nowrap}.hero-proof b{display:block;color:var(--accent);font-size:12px;margin-bottom:8px}.orb-scene{position:relative;width:340px;height:460px;margin-left:-65px;z-index:-1;perspective:900px;filter:drop-shadow(0 30px 28px #0008)}.orbit-main,.orbit-back,.orbit-inner{position:absolute;border-radius:50%;transform:rotateY(-27deg) rotateZ(-20deg);width:330px;height:330px;top:50px;left:0}.orbit-main{border:9px solid #65d9ff;box-shadow:inset 2px 2px 8px #e8fdff,inset -6px -4px 15px #087eaa,0 0 8px #d7fbff,0 0 26px #1dbee3a8,12px 8px 0 #116c82,17px 14px 15px #0009;background:radial-gradient(ellipse,#65d9ff08 48%,#65d9ff2a 69%,transparent 70%)}.orbit-back{border:1px solid #65d9ff22;width:380px;height:380px;left:-25px;top:25px;transform:rotateY(-27deg) rotateZ(-20deg)}.orbit-inner{border:1px solid #65d9ff33;width:284px;height:284px;left:23px;top:73px}.orb-core{position:absolute;top:169px;left:50px;width:240px;text-align:center;transform:rotateY(-18deg)}.orb-core>span{font-size:8px;letter-spacing:2px;color:var(--accent)}.orb-core strong{display:block;margin-top:15px;font-size:21px;line-height:1.5;font-weight:400}.orb-core i{display:block;font-style:normal;font-size:8px;letter-spacing:4px;margin-top:25px;color:var(--muted)}.float-chip{position:absolute;left:65px;bottom:55px;background:linear-gradient(130deg,#24374aee,#132337ee);border:1px solid #65d9ff32;padding:17px 22px;display:flex;gap:15px;align-items:center;border-radius:12px;transform:rotate(-6deg);font-size:12px;box-shadow:0 12px 30px #0005}.float-chip small{display:block;color:var(--muted);font-size:10px;margin-top:6px}.chip-icon{color:var(--accent);font-size:22px}.login-card{background:linear-gradient(140deg,#1a2c40eb,#101b2cf5);padding:32px;border:1px solid #9ac8e333;border-radius:20px;box-shadow:0 28px 65px #0006,inset 0 1px #ffffff0d;transform:perspective(1200px) rotateY(-3deg);position:relative;z-index:2}.card-kicker{font-size:8px;letter-spacing:2px;color:var(--accent)}.login-card h2{margin-top:22px;margin-bottom:10px;font-size:26px}.login-card>p{font-size:13px}.login-card label,dialog label{display:block;font-size:12px;margin:19px 0 0;color:var(--muted)}input,select{width:100%;color:var(--text);background:#0b1626;border:1px solid #ffffff1c;padding:13px 12px;border-radius:8px;margin-top:8px;min-height:44px}input::placeholder{color:#71869e}input[type=checkbox]{width:19px;min-height:19px;margin:0;accent-color:var(--accent)}.password-wrap{position:relative}.password-wrap input{padding-right:43px}.password-toggle{position:absolute;right:4px;top:12px;padding:10px;background:transparent;color:var(--muted)}.error{color:var(--red);font-size:12px;line-height:1.5;margin:12px 0;min-height:4px}.auth-switch{font-size:11px!important;text-align:center;margin-top:24px;margin-bottom:22px}.auth-switch button{font-size:11px}.login-divider{height:1px;background:var(--line)}.demo-link{width:100%;background:transparent;padding:20px 0 0;display:flex;justify-content:space-between;font-size:12px}.local-hint{font-size:10px!important;margin-top:13px;margin-bottom:0}.landing-footer{padding:25px 5%;display:flex;justify-content:space-between;color:#8195ac;font-size:9px;letter-spacing:1.5px;border-top:1px solid var(--line)}
/* Lerncockpit */
#workspace{display:flex;min-height:100vh}.sidebar{width:224px;flex-shrink:0;padding:22px 20px;border-right:1px solid var(--line);position:fixed;top:0;bottom:0;background:#0d1726;display:flex;flex-direction:column}.sidebar .brand{margin-left:4px;margin-bottom:35px}.nav-caption{font-size:9px;letter-spacing:2px;color:#7f94ac;padding:0 16px;margin-bottom:18px}nav{display:grid;gap:7px}nav button{background:transparent;color:var(--muted);text-align:left;padding:14px 15px;border-radius:9px;font-size:13px;display:flex;align-items:center;gap:13px}nav button span{font-size:21px;width:20px}nav button:hover{background:#ffffff05}nav button.active{color:var(--accent);background:#65d9ff10;box-shadow:inset 2px 0 var(--accent)}nav b{margin-left:auto;font-size:10px} .sidebar-bottom{margin-top:auto}.sidebar-quote{border:1px solid var(--line);border-radius:13px;padding:23px 16px;font-size:14px;line-height:1.6;color:var(--muted);overflow:hidden;position:relative;margin-bottom:22px;height:135px}.sidebar-quote strong{color:var(--text);font-weight:400}.tiny-orbit{height:85px;width:85px;border:3px solid #65d9ff80;border-radius:50%;position:absolute;right:-20px;bottom:-30px;box-shadow:0 0 15px #65d9ff30}.profile{display:flex;background:transparent;align-items:center;gap:10px;font-size:12px;text-align:left;width:100%}.avatar{height:35px;width:35px;border-radius:50%;display:grid;place-items:center;background:#253b50;color:var(--accent);flex-shrink:0}.profile small{display:block;font-size:9px;color:var(--muted);margin-top:5px}.logout{margin:16px 0 0 44px;font-size:10px;color:var(--muted)}.workspace-main{margin-left:224px;width:calc(100% - 224px)}.app-header{height:86px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 42px;font-size:12px;color:var(--muted)}.app-header b{font-weight:400;color:var(--text);margin-left:10px}.app-header>div{display:flex;align-items:center;gap:17px}.mode-badge{font-size:10px;color:var(--accent);border:1px solid #65d9ff33;border-radius:20px;padding:5px 9px}.header-focus{background:transparent;border:1px solid var(--line);padding:10px 13px;border-radius:8px;font-size:11px}#content{max-width:1480px;padding:39px 42px;margin:auto;min-height:calc(100vh - 140px);outline:none}.page-title{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:28px}.page-title h1{font-size:31px;letter-spacing:-1px;margin:10px 0}.page-title p{font-size:13px;color:var(--muted);margin:0}.eyebrow.compact{margin:0;letter-spacing:1.8px;font-size:9px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:24px}.stat{padding:23px 25px;background:linear-gradient(115deg,#17263b99,#111d2e80);border:1px solid var(--line);border-radius:13px}.stat-label{font-size:11px;color:var(--muted);display:flex;justify-content:space-between}.stat strong{font-weight:400;font-size:31px;display:block;margin:19px 0 11px;letter-spacing:-.8px}.stat strong small{font-size:13px;color:var(--muted);letter-spacing:0}.stat-foot{font-size:10px;color:var(--muted)}.stat-foot em{font-style:normal;color:var(--accent)}.grid-main{display:grid;grid-template-columns:1.45fr 1fr;gap:23px}.panel{background:#101c2d;border:1px solid var(--line);border-radius:14px;padding:25px;margin-bottom:23px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}.panel-head h2{font-size:17px;letter-spacing:-.2px;margin:0}.panel-head .text-button{font-size:11px}.panel-head .muted{font-size:10px}.chart{display:flex;align-items:flex-end;justify-content:space-around;gap:9px;height:177px;padding-top:10px;border-bottom:1px solid var(--line)}.chart-col{height:100%;flex:1;display:flex;align-items:flex-end;justify-content:center;gap:6px;position:relative;padding-bottom:26px}.bar{width:15px;background:#284058;border-radius:4px 4px 0 0;min-height:2px;max-height:100%}.bar.actual{background:linear-gradient(#8be5ff,#35a8ce)}.chart-col label{position:absolute;bottom:0;font-size:10px;color:var(--muted)}.chart-legend{display:flex;gap:20px;font-size:10px;color:var(--muted);margin-top:19px}.chart-legend i{width:7px;height:7px;display:inline-block;background:#284058;border-radius:2px;margin-right:6px}.chart-legend i.actual{background:var(--accent)}.focus-panel{background:radial-gradient(ellipse at 50% 50%,#224c6333,transparent 65%),#111e30;text-align:center}.focus-panel .panel-head{text-align:left}.focus-time{font-size:43px;font-weight:400;letter-spacing:2px;font-variant-numeric:tabular-nums;margin:24px 0 7px}.focus-caption{font-size:11px;color:var(--muted);margin-bottom:20px}.focus-panel select{font-size:12px;text-align:left}.focus-controls{display:flex;gap:10px;justify-content:center;margin-top:18px}.focus-controls .primary{flex:1}.task-row{display:flex;gap:13px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}.task-row:last-child{border:0}.task-row input{flex-shrink:0}.task-body{flex:1;min-width:0}.task-body strong{font-size:12px;display:block;font-weight:400}.task-body small{font-size:10px;color:var(--muted);display:block;margin-top:6px}.task-row.done strong{text-decoration:line-through;color:var(--muted)}.pill{border-radius:5px;font-size:9px;padding:5px 8px;display:inline-block;white-space:nowrap;background:#65d9ff12;color:var(--accent)}.pill.warn{background:#f3c48b14;color:var(--orange)}.pill.good{background:#89dbbd14;color:var(--green)}.pill.bad{background:#ffaaa914;color:var(--red)}.goal-row{padding:14px 0;border-bottom:1px solid var(--line)}.goal-row:last-child{border-bottom:0}.goal-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:11px;font-size:12px}.goal-row .muted{font-size:10px}.progress{height:5px;background:#26394e;border-radius:10px;overflow:hidden;margin:12px 0}.progress span{display:block;height:100%;background:var(--accent);border-radius:10px}.goal-bottom{display:flex;justify-content:space-between;color:var(--muted);font-size:10px}.insight{padding:17px 20px;border:1px solid #65d9ff25;background:#65d9ff07;border-radius:11px;display:flex;justify-content:space-between;gap:15px;font-size:12px;align-items:center;line-height:1.6}.insight .text-button{white-space:nowrap}.app-footer{padding:12px 42px 22px;display:flex;justify-content:space-between;font-size:9px;color:#8094ab}.toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:24px}.toolbar input,.toolbar select{width:auto;margin:0;font-size:12px}.tabs{display:flex;gap:4px;border:1px solid var(--line);padding:4px;border-radius:10px}.tabs button{padding:10px 16px;background:transparent;border-radius:7px;font-size:12px;color:var(--muted)}.tabs button.active{background:var(--surface2);color:var(--text)}.months-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.month-card{padding:22px;background:var(--surface);border:1px solid var(--line);border-radius:13px}.month-card h3{margin:14px 0}.month-card .small{line-height:1.7}.month-card input{margin-top:16px}.month-card label{font-size:11px;color:var(--muted)}.section-label{font-size:11px;letter-spacing:1.5px;color:var(--accent);margin-bottom:17px}.goals-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.goal-card{margin:0}.goal-card h2{font-size:22px;margin:15px 0}.goal-card p{font-size:12px;color:var(--muted)}.card-actions{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}.card-actions button{font-size:11px}.icon-button{font-size:22px;background:transparent;color:var(--muted);padding:3px 8px;line-height:1}.delete{color:var(--red)}.empty{text-align:center;padding:35px 20px;color:var(--muted);font-size:13px;line-height:1.8}.focus-large{max-width:650px;margin:30px auto}.focus-large .focus-time{font-size:70px;margin:45px 0 10px}.focus-large .panel{padding:35px}.list-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 0;border-bottom:1px solid var(--line);font-size:12px}.list-line:last-child{border:0}.list-line small{display:block;color:var(--muted);margin-top:5px}.alert-item{padding:20px;border:1px solid var(--line);border-radius:12px;margin-bottom:14px;background:var(--surface);display:flex;gap:17px;align-items:center}.alert-item>span{color:var(--orange);font-size:25px}.alert-item h3{margin:0 0 7px;font-size:14px}.alert-item p{margin:0;font-size:12px;color:var(--muted)}.alert-item .text-button{margin-left:auto;white-space:nowrap}dialog{color:var(--text);background:#142237;border:1px solid #65d9ff33;border-radius:17px;width:min(530px,calc(100vw - 30px));padding:28px;box-shadow:0 30px 100px #0009;max-height:90vh}dialog::backdrop{background:#020a16bd;backdrop-filter:blur(6px)}.dialog-head{display:flex;justify-content:space-between;align-items:center}.dialog-head h2{margin:0;font-size:23px}.dialog-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:25px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}.help{font-size:12px;color:var(--muted);line-height:1.7}.check-label{display:flex!important;align-items:center;gap:10px}#toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);padding:14px 22px;background:#264252;border:1px solid #65d9ff66;border-radius:10px;font-size:12px;z-index:50;box-shadow:0 10px 40px #0006;max-width:90vw}.inline-actions{display:flex;gap:6px;align-items:center}
@media(min-width:1550px){.orb-scene{margin-left:-25px}.hero{gap:20px}}@media(max-width:1200px){.hero{grid-template-columns:1fr 350px;gap:50px}.orb-scene{position:absolute;right:340px;top:170px;opacity:.23;z-index:-1}.hero-copy{max-width:520px}.hero-proof{gap:15px}.grid-main{grid-template-columns:1.2fr 1fr}#content{padding:30px 25px}.app-header{padding:0 25px}.sidebar{width:200px;padding:20px 14px}.workspace-main{margin-left:200px;width:calc(100% - 200px)}}@media(max-width:900px){.hero{padding:55px 5%;gap:24px;grid-template-columns:1fr 330px}h1{font-size:43px}.header-note{display:none}.hero-proof{flex-wrap:wrap;line-height:1.4}.login-card{padding:26px}.hero-actions .primary{font-size:12px}.grid-main{grid-template-columns:1fr}.sidebar{width:176px;padding:20px 10px}.sidebar .brand{width:150px}.workspace-main{margin-left:176px;width:calc(100% - 176px)}.stats{gap:10px}.stat{padding:18px 14px}.stat strong{font-size:26px}.months-grid{grid-template-columns:repeat(2,1fr)}.goals-grid{grid-template-columns:1fr}.page-title h1{font-size:27px}.page-title .primary{padding:12px;gap:12px}}@media(max-width:650px){.landing-header{height:85px;padding:12px 6%}.brand{width:150px}.hero{grid-template-columns:1fr;padding:45px 7%;gap:45px}.hero-copy{max-width:100%}h1{font-size:46px}.hero-lead{font-size:14px}.orb-scene{right:-20px;top:90px;opacity:.18}.login-card{transform:none}.hero-proof{margin-top:35px}.landing-footer{gap:18px;line-height:1.8;flex-direction:column}.sidebar{position:fixed;top:auto;bottom:0;width:100%;height:70px;padding:0 5px;z-index:10;border-top:1px solid var(--line);border-right:0;background:#0d1726f5}.sidebar .brand,.nav-caption,.sidebar-bottom{display:none}.sidebar nav{display:flex;justify-content:space-around;height:100%;gap:0}.sidebar nav button{flex-direction:column;gap:3px;font-size:9px;padding:10px 7px;justify-content:center;border-radius:0;position:relative;flex:1}.sidebar nav button span{font-size:21px}.sidebar nav button.active{box-shadow:inset 0 2px var(--accent)}nav b{position:absolute;right:8px;top:6px}.workspace-main{width:100%;margin-left:0;padding-bottom:70px}.app-header{height:65px;padding:0 20px}.app-header b{display:none}.app-header>div{gap:8px}.header-focus{font-size:10px}#content{padding:26px 18px}.page-title{align-items:flex-start}.page-title h1{font-size:28px}.page-title p{font-size:12px}.page-title .primary{font-size:11px;white-space:nowrap;margin-top:24px}.stats{grid-template-columns:1fr;gap:10px}.stat{padding:16px 20px;display:grid;grid-template-columns:1fr 1fr;align-items:center}.stat strong{text-align:right;margin:0}.stat-foot{margin-top:9px}.panel{padding:20px}.months-grid{grid-template-columns:1fr}.app-footer{padding:12px 18px;gap:15px;font-size:8px}.insight{align-items:flex-start;flex-direction:column}.focus-large .focus-time{font-size:53px}.focus-large .panel{padding:24px}.alert-item{align-items:flex-start;flex-wrap:wrap}.hero-actions{margin-top:25px}.field-row{grid-template-columns:1fr}.toolbar .tabs{width:100%}.toolbar .tabs button{flex:1}.goal-top{align-items:flex-start}.focus-controls{flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* Die dekorative Szene darf auf schmalen Bildschirmen nicht überlaufen. */
.hero{overflow:hidden}
